@page
@model Almacen.Pages.PageCliente.AltaModel
@{
    ViewData["Title"] = "Agregar Cliente";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar un Cliente</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" />
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text" name="nombre" id="nombre" />
                </div>
                <div class="form-group">
                    <label for="tipo">Apellido:</label>
                    <input class="form-control" type="text" name="apellido" id="apellido"/>
                </div>
                <div class="form-group">
                    <label for="stock">Dirección:</label>
                    <input class="form-control" type="text" name="direccion" id="direccion"/>
                </div>
                <div class="form-group">
                    <label for="precio">Teléfono:</label>
                    <input class="form-control" type="text" name="telefono" id="telefono" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>