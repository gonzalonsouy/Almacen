@page
@model Almacen.Pages.PageVenta.AltaModel
@{
    ViewData["Title"] = "Agregar Venta";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar una Venta</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" />
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="fecha">Fecha:</label>
                    <input class="form-control" type="date" name="fecha" id="fecha" />
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="cliente">Cliente:</label>
                    <select class="form-control" id="idCliente" name="idCliente">
                        <option value="">Seleccione un Cliente</option>
                            @foreach (Dominio.Cliente unCliente in Model.Clientes)
                            {
                                <option value="@unCliente.Id">@unCliente.Nombre @unCliente.Apellido</option>
                            }
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-1">
                <div class="form-group">
                    <label for="idLinea">ID:</label>
                    <input class="form-control" type="text" name="idLinea" id="idLinea" />
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="producto">Producto:</label>
                    <select class="form-control" id="idProducto" name="idProducto" onchange="CargarPrecio()">
                        <option value="">Seleccione un Producto</option>
                        @foreach (Dominio.Producto unProducto in Model.Productos)
                        {
                            <option value="@unProducto.Id">@unProducto.Nombre</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">
                    <label for="precio">Precio:</label>
                    <input class="form-control" type="number" name="precio" id="precio" value="@Model.producto.Precio" readonly />
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">
                    <label for="cantidad">Cantidad:</label>
                    <input class="form-control" type="number" name="cantidad" id="cantidad" />
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">
                    <label for="subtotal">SubTotal:</label>
                    <input class="form-control" type="number" name="subtotal" id="subtotal" readonly />
                </div>
            </div>
            <div class="col-sm-1" style="margin-top: 24px;">
                <button class="btn btn-success" type="submit" asp-page-handler="AgregarLinea">Agregar</button>
            </div>
        </div>
        
        <hr />
        <table class="table text-center">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>SubTotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LineasVenta != null && Model.LineasVenta.Any())
                {
                    @foreach (Dominio.LineaVenta unaLinea in Model.LineasVenta)
                    {
                        <tr>
                            <td>@unaLinea.Id</td>
                            <td>@unaLinea.Producto.Nombre</td>
                            <td>@unaLinea.Producto.Precio</td>
                            <td>@unaLinea.Cantidad</td>
                            <td>@unaLinea.SubTotal</td>
                            <td>
                                <div>
                                    <a class="btn btn-danger" asp-page="./EliminarLinea" asp-route-id="@unaLinea.Id">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No hay Lineas ingresadas
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <hr />
        <div class="row">
            <div class="col-sm-10"></div>
            <div class="col-sm-2 text-right">
                <div class="form-group">
                    <label for="total">Total:</label>
                    <input class="form-control" type="number" name="total" id="total" value="@Model.total" readonly />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-10"></div>
            <div class="col-sm-2 text-right">
                <button class="btn btn-info" type="submit" asp-page-handler="AgregarLinea">Agregar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
        
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>