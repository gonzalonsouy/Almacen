@page
@model Almacen.Pages.Producto.EliminarModel
@{
    ViewData["Title"] = "Eliminar Producto";
}
<div class="text left">
    <h1 class="display-4 text-center">Eliminar Producto</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.producto.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.producto.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.producto.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.producto.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.producto.Tipo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.producto.Tipo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.producto.Stock)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.producto.Stock)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.producto.Precio)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.producto.Precio)
        </dd>
    </dl>
    <hr />

    <form method="post">
        <input type="hidden" name="id" value="@Model.producto.Id"/>
        <div class="row">
            <div class="mt-2">
                <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
</div>